# ============================================================================
# GrowFolio CMS - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# DATABASE
# ============================================================================
# Railway automatically provides DATABASE_URL for PostgreSQL
# For local development, use: postgresql://username:password@localhost/growfolio
DATABASE_URL=postgresql://localhost/growfolio

# ============================================================================
# SECURITY
# ============================================================================
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production

# ============================================================================
# GOOGLE API CREDENTIALS
# ============================================================================
# Required for Google Meet integration
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ============================================================================
# EMAIL CONFIGURATION (Google SMTP)
# ============================================================================
# Gmail SMTP settings for sending emails from help@grow-folio.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=help@grow-folio.in
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=help@grow-folio.in
SMTP_FROM_NAME=GrowFolio

# ============================================================================
# STORAGE
# ============================================================================
# Storage type: 'local' or 's3'
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ============================================================================
# AWS S3 (Optional - for future scalability)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=growfolio-documents
AWS_REGION=ap-south-1

# ============================================================================
# APP SETTINGS
# ============================================================================
# Set to False in production!
DEBUG=True
PORT=8000

# For local development
FRONTEND_URL=http://localhost:8000

# For production on Railway with custom domain
# FRONTEND_URL=https://cms.grow-folio.in

# ============================================================================
# NOTES
# ============================================================================
# 1. For Google SMTP with Gmail:
#    - Enable 2-factor authentication on your Google account
#    - Generate an App Password: https://myaccount.google.com/apppasswords
#    - Use the app password as SMTP_PASSWORD
#
# 2. For Google Calendar API (Google Meet):
#    - Create a project in Google Cloud Console
#    - Enable Google Calendar API
#    - Create OAuth 2.0 credentials
#    - Add authorized redirect URIs
#
# 3. For Railway deployment:
#    - Railway automatically provides DATABASE_URL
#    - Set all other environment variables in Railway dashboard
#    - Set DEBUG=False in production
